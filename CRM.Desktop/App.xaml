<Application x:Class="CRM.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CRM.Desktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Teal" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibility" />
            <Style TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#344054" />
                <Setter Property="BorderBrush" Value="#D9E2EC" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#2F80ED" />
                        <Setter Property="Background" Value="#F0F7FF" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#D9E2EC" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style TargetType="{x:Type PasswordBox}">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="BorderBrush" Value="#D9E2EC" />
            </Style>
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="IsEditable" Value="True" />
                <Setter Property="IsTextSearchEnabled" Value="True" />
                <Setter Property="IsTextSearchCaseSensitive" Value="False" />
                <Setter Property="StaysOpenOnEdit" Value="True" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#D9E2EC" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style TargetType="{x:Type DatePicker}">
                <Setter Property="Height" Value="36" />
                <Setter Property="BorderBrush" Value="#D9E2EC" />
            </Style>
            <Style TargetType="{x:Type DataGrid}">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#E4EAF1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="RowBackground" Value="#FFFFFF" />
                <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F5" />
                <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
                <Setter Property="RowHeight" Value="44" />
                <Setter Property="HeadersVisibility" Value="Column" />
            </Style>
            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="#F7F9FC" />
                <Setter Property="Foreground" Value="#667085" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Height" Value="42" />
                <Setter Property="BorderBrush" Value="#E4EAF1" />
            </Style>
            <Style TargetType="{x:Type DataGridCell}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="{x:Type ProgressBar}">
                <Setter Property="Height" Value="7" />
                <Setter Property="Foreground" Value="#2F80ED" />
                <Setter Property="Background" Value="#E7EEF8" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
