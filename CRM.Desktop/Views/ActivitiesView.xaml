<UserControl x:Class="CRM.Desktop.Views.ActivitiesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,25">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Activities &amp; Follow-ups" FontSize="28" FontWeight="Bold" Foreground="#18283C"/><TextBlock Text="Log customer interactions, reminders and sales tasks" Foreground="#77849A"/></StackPanel>
      <Button Grid.Column="1" Content="＋ Log Activity" Command="{Binding NewActivityCommand}" Background="#1677C8" Foreground="White" Padding="16,9" BorderThickness="0"/>
    </Grid>
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,18,0,14">
      <StackPanel Orientation="Horizontal"><TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox Width="145" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedType}"/><TextBlock Text="Status" VerticalAlignment="Center" Margin="22,0,7,0"/><ComboBox Width="120" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}"/></StackPanel>
    </Border>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Activities}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.CompanyName}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/><DataGridTextColumn Header="Activity" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Assigned to" Binding="{Binding AssignedTo}" Width="130"/><DataGridTextColumn Header="Reminder" Binding="{Binding ReminderAt, StringFormat={}{0:g}}" Width="135"/><DataGridTextColumn Header="Status" Binding="{Binding IsCompleted}" Width="85"/>
        <DataGridTemplateColumn Header="Actions" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Complete" Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}" Grid.RowSpan="3" Background="#99000000">
      <Border Width="600" Padding="28" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel>
        <TextBlock Text="Log activity" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding EditorError}" Foreground="#C83D3D" Margin="0,5"/>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="CompanyName" SelectedValuePath="Id" SelectedValue="{Binding Editor.CustomerId}" ToolTip="Customer *" Margin="0,0,10,8"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding Editor.Type}" ToolTip="Activity type" Margin="0,0,0,8"/>
          <TextBox Grid.Row="1" Text="{Binding Editor.Title}" ToolTip="Activity title *" Margin="0,0,10,8"/>
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SalesPeople}" SelectedItem="{Binding Editor.AssignedTo}" IsEnabled="{Binding CanAssign}" ToolTip="Assigned sales" Margin="0,0,0,8"/>
          <DatePicker Grid.Row="2" SelectedDate="{Binding Editor.ReminderAt}" ToolTip="Reminder (optional)" Margin="0,0,10,0"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Set a reminder for follow-ups or tasks." Foreground="#718096" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Grid>
        <TextBox Text="{Binding Editor.Details}" ToolTip="Notes" Height="78" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Cancel" Command="{Binding CancelEditCommand}"/><Button Content="Save activity" Command="{Binding SaveActivityCommand}" Background="#1677C8" Foreground="White" Margin="8,0,0,0"/></StackPanel>
      </StackPanel></Border>
    </Grid>
  </Grid>
</UserControl>
