<UserControl x:Class="CRM.Desktop.Views.OpportunitiesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Opportunity Pipeline" FontSize="28" FontWeight="Bold" Foreground="#18283C"/><TextBlock Text="Move deals through the sales pipeline" Foreground="#77849A"/></StackPanel><Button Grid.Column="1" Content="＋ New Opportunity" Command="{Binding NewOpportunityCommand}" Background="#1677C8" Foreground="White" Padding="16,9" BorderThickness="0"/></Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,20,0,0"><ItemsControl ItemsSource="{Binding Columns}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="230" Background="#EAF0F6" CornerRadius="8" Padding="10" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#23364D"/><TextBlock Text="{Binding Opportunities.Count}" HorizontalAlignment="Right" Foreground="#62748A"/></Grid><ItemsControl Grid.Row="1" ItemsSource="{Binding Opportunities}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="6" Padding="11" Margin="0,0,0,9"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Customer.CompanyName}" Foreground="#718096" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="{Binding Value, StringFormat={}{0:C0}}" Foreground="#1677C8" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding OwnerName}" Foreground="#718096" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="‹" Command="{Binding DataContext.MovePreviousCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="Edit" Command="{Binding DataContext.EditOpportunityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="5,0"/><Button Content="›" Command="{Binding DataContext.MoveNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}" Grid.RowSpan="2" Background="#99000000"><Border Width="620" Padding="28" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Opportunity details" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding EditorError}" Foreground="#C83D3D" Margin="0,5"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBox Text="{Binding Editor.Name}" ToolTip="Opportunity name *" Margin="0,0,10,8"/><ComboBox Grid.Column="1" ItemsSource="{Binding Customers}" DisplayMemberPath="CompanyName" SelectedValuePath="Id" SelectedValue="{Binding Editor.CustomerId}" ToolTip="Customer" Margin="0,0,0,8"/><TextBox Grid.Row="1" Text="{Binding Editor.Value}" ToolTip="Value *" Margin="0,0,10,8"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Stages}" SelectedItem="{Binding Editor.Stage}"/><ComboBox Grid.Row="2" ItemsSource="{Binding SalesPeople}" SelectedItem="{Binding Editor.OwnerName}" IsEnabled="{Binding CanAssign}" ToolTip="Owner" Margin="0,0,10,0"/><DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding Editor.ExpectedCloseAt}" ToolTip="Expected close date"/></Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancel" Command="{Binding CancelEditCommand}"/><Button Content="Save opportunity" Command="{Binding SaveOpportunityCommand}" Background="#1677C8" Foreground="White" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></Grid>
  </Grid>
</UserControl>
