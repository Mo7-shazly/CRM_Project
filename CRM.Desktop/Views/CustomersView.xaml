<UserControl x:Class="CRM.Desktop.Views.CustomersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,25">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Customers" FontSize="28" FontWeight="Bold" Foreground="#18283C"/><TextBlock Text="Manage customers, contacts and history" Foreground="#77849A"/></StackPanel><Button Grid.Column="1" Content="Add Customer" Command="{Binding NewCustomerCommand}" Background="#1677C8" Foreground="White" Padding="16,9" BorderThickness="0"/></Grid>
    <TextBox Grid.Row="1" Width="280" HorizontalAlignment="Left" Margin="0,18,0,14" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search company, phone or email"/>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Customers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding CustomerCode}" Width="75"/><DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="*"/><DataGridTextColumn Header="Industry" Binding="{Binding Industry}" Width="*"/><DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="135"/><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/><DataGridTemplateColumn Header="Actions" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Open" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><Button Content="Edit" Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="5,0"/><Button Content="Delete" Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Foreground="#C83D3D" Margin="5,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}" Grid.RowSpan="3" Background="#99000000"><Border Width="850" Padding="28" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="{Binding Detail.CompanyName}" FontSize="25" FontWeight="Bold"/><TextBlock Text="{Binding Detail.Industry}" Foreground="#718096"/></StackPanel><Button Content="Close" Command="{Binding CloseDetailCommand}" HorizontalAlignment="Right"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" BorderThickness="0" Margin="0,18,0,10"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox><Grid Grid.Row="2"><Grid Visibility="{Binding SelectedTab, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Overview}"><StackPanel><TextBlock Text="Company information" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Detail.Website}" Margin="0,12,0,2"/><TextBlock Text="{Binding Detail.Phone}"/><TextBlock Text="{Binding Detail.Email}"/><TextBlock Text="{Binding Detail.Address}"/></StackPanel></Grid><Grid Visibility="{Binding SelectedTab, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Contacts}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><ItemsControl ItemsSource="{Binding Detail.Contacts}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/><TextBlock Text="{Binding JobTitle}"/><TextBlock Text="{Binding Phone}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Grid.Column="1"><TextBlock Text="Add contact" FontWeight="SemiBold"/><TextBox Text="{Binding NewContactName}" ToolTip="Name"/><TextBox Text="{Binding NewContactTitle}" ToolTip="Title"/><TextBox Text="{Binding NewContactPhone}" ToolTip="Phone"/><TextBox Text="{Binding NewContactEmail}" ToolTip="Email"/><Button Content="Add contact" Command="{Binding AddContactCommand}"/></StackPanel></Grid><Grid Visibility="{Binding SelectedTab, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Activities}"><ItemsControl ItemsSource="{Binding Detail.Activities}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}"/><TextBlock Text="{Binding OccurredAt}" Foreground="#718096" FontSize="11"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid><Grid Visibility="{Binding SelectedTab, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Opportunities}"><TextBlock Text="Available in Phase 5"/></Grid><Grid Visibility="{Binding SelectedTab, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Quotations}"><TextBlock Text="Available in Phase 6"/></Grid><Grid Visibility="{Binding SelectedTab, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Projects}"><TextBlock Text="Available in Phase 7"/></Grid><Grid Visibility="{Binding SelectedTab, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Files}"><TextBlock Text="Available in a later phase"/></Grid></Grid></Grid></Border></Grid>
    <Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}" Grid.RowSpan="3" Background="#99000000"><Border Width="620" Padding="28" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Customer details" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding EditorError}" Foreground="#C83D3D" Margin="0,5"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBox Text="{Binding Editor.CompanyName}" ToolTip="Company name *" Margin="0,0,10,8"/><TextBox Grid.Column="1" Text="{Binding Editor.Industry}" ToolTip="Industry" Margin="0,0,0,8"/><TextBox Grid.Row="1" Text="{Binding Editor.Phone}" ToolTip="Phone" Margin="0,0,10,8"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Editor.Email}" ToolTip="Email" Margin="0,0,0,8"/><TextBox Grid.Row="2" Text="{Binding Editor.Website}" ToolTip="Website" Margin="0,0,10,8"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Editor.CompanySize}" ToolTip="Company size" Margin="0,0,0,8"/><ComboBox Grid.Row="3" ItemsSource="{Binding CustomerPriorities}" SelectedItem="{Binding Editor.Priority}" Margin="0,0,10,8" ToolTip="Priority"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding CustomerStatuses}" SelectedItem="{Binding Editor.Status}" Margin="0,0,0,8"/><TextBox Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding Editor.Address}" ToolTip="Address"/></Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancel" Command="{Binding CancelEditCommand}"/><Button Content="Save customer" Command="{Binding SaveCustomerCommand}" Background="#1677C8" Foreground="White" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></Grid>
  </Grid>
</UserControl>
