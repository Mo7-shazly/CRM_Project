<UserControl x:Class="CRM.Desktop.Views.ProjectsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="28,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Projects" FontSize="28" FontWeight="Bold" Foreground="#18283C"/><TextBlock Text="Plan and track customer delivery" Foreground="#77849A"/></StackPanel><Button Grid.Column="1" Content="New Project" Command="{Binding NewProjectCommand}" Background="#1677C8" Foreground="White" Padding="16,9" BorderThickness="0"/></Grid><DataGrid Grid.Row="1" Margin="0,20,0,0" ItemsSource="{Binding Projects}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Project #" Binding="{Binding ProjectCode}" Width="90"/><DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Customer" Binding="{Binding Customer.CompanyName}" Width="*"/><DataGridTextColumn Header="Owner" Binding="{Binding AssignedTo}" Width="130"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/><DataGridTemplateColumn Header="Progress" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}" FontSize="11" Foreground="#667085" VerticalAlignment="Center" TextAlignment="Right"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header=""><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Edit" Command="{Binding DataContext.EditProjectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}" Grid.RowSpan="2" Background="#99000000"><Border Width="650" Padding="28" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Project details" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding EditorError}" Foreground="#C83D3D"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBox Text="{Binding Editor.Name}" ToolTip="Project name *" Margin="0,0,10,8"/><ComboBox Grid.Column="1" ItemsSource="{Binding Customers}" DisplayMemberPath="CompanyName" SelectedValuePath="Id" SelectedValue="{Binding Editor.CustomerId}" ToolTip="Customer *"/><ComboBox Grid.Row="1" ItemsSource="{Binding People}" SelectedItem="{Binding Editor.AssignedTo}" IsEnabled="{Binding CanAssign}" Margin="0,0,10,8"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Editor.Status}"/><TextBox Grid.Row="2" Text="{Binding Editor.Progress}" ToolTip="Progress (0-100)" Margin="0,0,10,0"/><DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding Editor.EndDate}" ToolTip="Target end date"/></Grid><TextBox Text="{Binding Editor.Notes}" ToolTip="Notes" Height="60" AcceptsReturn="True" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Cancel" Command="{Binding CancelEditCommand}"/><Button Content="Save project" Command="{Binding SaveProjectCommand}" Background="#1677C8" Foreground="White" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></Grid></Grid></UserControl>
