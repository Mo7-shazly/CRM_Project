<UserControl x:Class="CRM.Desktop.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,25,28,35">
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Business dashboard" FontSize="28" FontWeight="Bold" Foreground="#18283C"/><TextBlock Text="{Binding DashboardScope}" Foreground="#77849A" Margin="0,4,0,0"/></StackPanel><ComboBox Grid.Column="1" Height="34" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"/></Grid>
    <ItemsControl ItemsSource="{Binding Kpis}" Margin="0,0,0,18"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,14,0" BorderBrush="#E7ECF3" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" Foreground="#718096"/><TextBlock Text="{Binding Value}" FontSize="23" FontWeight="Bold" Foreground="#1B2B40" Margin="0,6,0,3"/><TextBlock Text="{Binding Change}" Foreground="#667085" FontSize="11"/></StackPanel><Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="{Binding Accent}" HorizontalAlignment="Right"><TextBlock Text="{Binding Icon}" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width=".85*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,14,0" BorderBrush="#E7ECF3" BorderThickness="1"><StackPanel><TextBlock Text="Won revenue — last 6 months" FontSize="16" FontWeight="SemiBold" Foreground="#243B53"/><TextBlock Text="Actual value from won opportunities" Foreground="#8590A0" FontSize="11" Margin="0,3,0,12"/><ItemsControl ItemsSource="{Binding SalesMonths}" Height="185"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"><TextBlock Text="{Binding Value, StringFormat={}{0:C0}}" FontSize="10" Foreground="#667085" HorizontalAlignment="Center" Margin="0,0,0,5"/><Border Width="30" Height="{Binding Height}" Background="#2E90FA" CornerRadius="4,4,0,0"/><TextBlock Text="{Binding Name}" Foreground="#667085" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E7ECF3" BorderThickness="1"><StackPanel><TextBlock Text="Pipeline by stage" FontSize="16" FontWeight="SemiBold" Foreground="#243B53"/><TextBlock Text="Count and value of opportunities" Foreground="#8590A0" FontSize="11" Margin="0,3,0,9"/><ItemsControl ItemsSource="{Binding Pipeline}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="13"/><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Count, StringFormat={}{0} opportunities}" Foreground="#8590A0" FontSize="10"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:C0}}" Foreground="#344054" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width=".95*"/><ColumnDefinition Width=".85*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,14,0" BorderBrush="#E7ECF3" BorderThickness="1"><StackPanel><DockPanel><TextBlock Text="Follow-ups due" FontSize="16" FontWeight="SemiBold" Foreground="#243B53"/><TextBlock Text="Action needed" Foreground="#F04438" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel><ItemsControl ItemsSource="{Binding FollowUps}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#8590A0" FontSize="10"/><TextBlock Text="{Binding AssignedTo}" Foreground="#8590A0" FontSize="10"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DueAt, StringFormat={}{0:dd MMM}}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#667085"/><Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#F04438"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" Margin="0,0,14,0" BorderBrush="#E7ECF3" BorderThickness="1"><StackPanel><TextBlock Text="Top sales performance" FontSize="16" FontWeight="SemiBold" Foreground="#243B53"/><ItemsControl ItemsSource="{Binding TopSales}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Deals, StringFormat={}{0} opportunities}" Foreground="#8590A0" FontSize="10"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Sales, StringFormat={}{0:C0}}" Foreground="#039855" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E7ECF3" BorderThickness="1"><StackPanel><TextBlock Text="Recent activity" FontSize="16" FontWeight="SemiBold" Foreground="#243B53"/><ItemsControl ItemsSource="{Binding RecentActivities}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,7"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Customer}" Foreground="#8590A0" FontSize="10"/><TextBlock Text="{Binding OccurredAt, StringFormat={}{0:dd MMM, HH:mm}}" Foreground="#98A2B3" FontSize="10"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </Grid>
  </StackPanel></ScrollViewer>
</UserControl>
