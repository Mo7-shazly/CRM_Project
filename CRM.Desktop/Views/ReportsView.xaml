<UserControl x:Class="CRM.Desktop.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,25"><TextBlock Text="Reports" FontSize="28" FontWeight="Bold" Foreground="#18283C"/><TextBlock Text="Business performance across your selected period" Foreground="#77849A"/><StackPanel Orientation="Horizontal" Margin="0,18,0,18"><TextBlock Text="From" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding FromDate}" Margin="8,0,15,0"/><TextBlock Text="To" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding ToDate}" Margin="8,0,15,0"/><Button Content="Apply" Command="{Binding RefreshCommand}" Background="#1677C8" Foreground="White"/></StackPanel><UniformGrid Columns="5"><Border Background="White" Padding="16" Margin="0,0,10,12"><StackPanel><TextBlock Text="Leads" Foreground="#718096"/><TextBlock Text="{Binding Leads}" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="White" Padding="16" Margin="0,0,10,12"><StackPanel><TextBlock Text="Customers" Foreground="#718096"/><TextBlock Text="{Binding Customers}" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="White" Padding="16" Margin="0,0,10,12"><StackPanel><TextBlock Text="Pipeline value" Foreground="#718096"/><TextBlock Text="{Binding OpportunityValue, StringFormat={}{0:C0}}" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="White" Padding="16" Margin="0,0,10,12"><StackPanel><TextBlock Text="Won value" Foreground="#718096"/><TextBlock Text="{Binding WonValue, StringFormat={}{0:C0}}" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="White" Padding="16" Margin="0,0,10,12"><StackPanel><TextBlock Text="Quotation value" Foreground="#718096"/><TextBlock Text="{Binding QuotationValue, StringFormat={}{0:C0}}" FontSize="22" FontWeight="Bold"/></StackPanel></Border></UniformGrid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="White" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="Sales performance" FontWeight="SemiBold" FontSize="16"/><DataGrid ItemsSource="{Binding Sales}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Salesperson" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Deals" Binding="{Binding Opportunities}"/><DataGridTextColumn Header="Won" Binding="{Binding Won}"/><DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat={}{0:C0}}"/></DataGrid.Columns></DataGrid></StackPanel></Border><Border Grid.Column="1" Background="White" Padding="18"><StackPanel><TextBlock Text="Pipeline by stage" FontWeight="SemiBold" FontSize="16"/><DataGrid ItemsSource="{Binding Pipeline}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="*"/><DataGridTextColumn Header="Deals" Binding="{Binding Count}"/><DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat={}{0:C0}}"/></DataGrid.Columns></DataGrid></StackPanel></Border></Grid></StackPanel></ScrollViewer></UserControl>
