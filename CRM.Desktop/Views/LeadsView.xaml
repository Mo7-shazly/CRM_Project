<UserControl x:Class="CRM.Desktop.Views.LeadsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="28,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Leads" FontSize="28" FontWeight="Bold" Foreground="#18283C"/><TextBlock Text="Track, qualify and assign potential customers" Foreground="#77849A"/></StackPanel><Button Grid.Column="1" Content="＋ Add Lead" Command="{Binding NewLeadCommand}" Background="#1677C8" Foreground="White" Padding="16,9" BorderThickness="0"/></Grid><Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,18,0,14"><WrapPanel><TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search"/><ComboBox Width="145" Margin="10,0" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}"/><ComboBox Width="145" ItemsSource="{Binding Assignees}" SelectedItem="{Binding SelectedAssignee}"/></WrapPanel></Border><DataGrid Grid.Row="2" ItemsSource="{Binding Leads}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding LeadCode}" Width="75"/><DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="*"/><DataGridTextColumn Header="Contact" Binding="{Binding ContactName}" Width="*"/><DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Assigned to" Binding="{Binding AssignedTo}" Width="130"/><DataGridTemplateColumn Header="Actions" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Edit" Command="{Binding DataContext.EditLeadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><Button Content="Delete" Command="{Binding DataContext.DeleteLeadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Foreground="#C83D3D" Margin="5,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}" Grid.RowSpan="3" Background="#99000000"><Border Width="650" Padding="28" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Lead details" FontSize="23" FontWeight="Bold"/><TextBlock Text="Add the potential customer's details first. You do not need to create a customer record." Foreground="#77849A" Margin="0,5,0,0"/><TextBlock Text="{Binding EditorError}" Foreground="#C83D3D"/><Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBox Text="{Binding Editor.Company, UpdateSourceTrigger=PropertyChanged}" ToolTip="Company name *" Margin="0,0,10,8"/><TextBox Grid.Column="1" Text="{Binding Editor.ContactName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Contact person *" Margin="0,0,0,8"/><TextBox Grid.Row="1" Text="{Binding Editor.Phone, UpdateSourceTrigger=PropertyChanged}" ToolTip="Phone" Margin="0,0,10,8"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Editor.Email, UpdateSourceTrigger=PropertyChanged}" ToolTip="Email" Margin="0,0,0,8"/><ComboBox Grid.Row="2" ItemsSource="{Binding SourceNames}" SelectedItem="{Binding Editor.Source}" Margin="0,0,10,8"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding StatusValues}" SelectedItem="{Binding Editor.Status}"/><ComboBox Grid.Row="3" ItemsSource="{Binding SalesPeople}" SelectedItem="{Binding Editor.AssignedTo}" IsEnabled="{Binding CanAssign}" Margin="0,0,10,0"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Editor.Score}" ToolTip="Score"/></Grid><TextBox Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Notes" Height="60" AcceptsReturn="True" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Cancel" Command="{Binding CancelEditCommand}"/><Button Content="Save Lead" Command="{Binding SaveLeadCommand}" Background="#1677C8" Foreground="White" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></Grid></Grid></UserControl>
