<Window x:Class="CRM.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CRM.Desktop" xmlns:vm="clr-namespace:CRM.Desktop.ViewModels" xmlns:views="clr-namespace:CRM.Desktop.Views" Title="CRM" Height="760" Width="1280" Background="#F5F7FB"><Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/><local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/><Style x:Key="Nav" TargetType="Button"><Setter Property="Foreground" Value="#C9D6E8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="8,2"/></Style><DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate><DataTemplate DataType="{x:Type vm:LeadsViewModel}"><views:LeadsView/></DataTemplate><DataTemplate DataType="{x:Type vm:CustomersViewModel}"><views:CustomersView/></DataTemplate><DataTemplate DataType="{x:Type vm:ActivitiesViewModel}"><views:ActivitiesView/></DataTemplate><DataTemplate DataType="{x:Type vm:OpportunitiesViewModel}"><views:OpportunitiesView/></DataTemplate><DataTemplate DataType="{x:Type vm:QuotationsViewModel}"><views:QuotationsView/></DataTemplate><DataTemplate DataType="{x:Type vm:ProjectsViewModel}"><views:ProjectsView/></DataTemplate><DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView/></DataTemplate><DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate></Window.Resources><Grid><Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#102B4E"><StackPanel><TextBlock Text="CRM" Foreground="White" FontSize="20" FontWeight="Bold" Margin="20,25,10,28"/><Button Style="{StaticResource Nav}" Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/><Button Style="{StaticResource Nav}" Content="Leads" Command="{Binding NavigateCommand}" CommandParameter="Leads"/><Button Style="{StaticResource Nav}" Content="Customers" Command="{Binding NavigateCommand}" CommandParameter="Customers"/><Button Style="{StaticResource Nav}" Content="Activities" Command="{Binding NavigateCommand}" CommandParameter="Activities"/><Button Style="{StaticResource Nav}" Content="Opportunities" Command="{Binding NavigateCommand}" CommandParameter="Opportunities"/><Button Style="{StaticResource Nav}" Content="Quotations" Command="{Binding NavigateCommand}" CommandParameter="Quotations"/><Button Style="{StaticResource Nav}" Content="Projects" Command="{Binding NavigateCommand}" CommandParameter="Projects"/><Button Style="{StaticResource Nav}" Content="Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports"/><Button Style="{StaticResource Nav}" Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"/><Separator Margin="15,16"/><Button Style="{StaticResource Nav}" Content="Sign out" Command="{Binding LogoutCommand}" Margin="8,35,8,2"/></StackPanel></Border><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition/></Grid.RowDefinitions><Border Background="White"><Grid Margin="25,0"><Grid Width="320" HorizontalAlignment="Left"><TextBox Height="34" Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search customers, leads and opportunities"/><Border Background="White" BorderBrush="#D7E0EA" BorderThickness="1" Margin="0,38,0,0" Visibility="{Binding HasGlobalResults, Converter={StaticResource BoolToVisibility}}"><ItemsControl ItemsSource="{Binding GlobalResults}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="10,5"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Type}" Foreground="#718096" FontSize="11"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border></Grid><Border Background="#DCEAFE" CornerRadius="16" Padding="11,7" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding CurrentUser.DisplayName}" Foreground="#195A99"/></Border></Grid></Border><ContentControl Grid.Row="1" Content="{Binding CurrentScreen}"/></Grid></Grid><Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibility}}"><Border Background="#102B4E"/><Border Width="470" Padding="42" Background="White" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="CRM" Foreground="#146EB4" FontSize="30" FontWeight="Bold"/><TextBlock Text="Sign in to manage your sales" Foreground="#748196" Margin="0,7,0,30"/><TextBlock Text="Email"/><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,17" Height="38"/><TextBlock Text="Password"/><PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" Margin="0,6,0,15" Height="38"/><TextBlock Text="{Binding LoginError}" Foreground="#D14343"/><Button Content="Sign in" Command="{Binding LoginCommand}" Height="42" Background="#1677C8" Foreground="White"/></StackPanel></Border></Grid></Grid></Window>
